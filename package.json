{
  "name": "xml-visual-viewer",
  "displayName": "XML Viewer",
  "description": "Explore XML as an interactive graph, with namespaces, search and source navigation.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "xml",
    "graph",
    "visualizer",
    "viewer",
    "namespace"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "xmlViewer.openPreview",
        "title": "Open Visual Preview",
        "category": "XML Viewer"
      },
      {
        "command": "xmlViewer.copyDiagnostics",
        "title": "Copy Diagnostic Report",
        "category": "XML Viewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xmlViewer.openPreview",
          "when": "resourceLangId == xml",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "xmlViewer.openPreview",
          "when": "resourceExtname == .xml",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "xmlViewer.preview",
        "displayName": "XML Viewer",
        "selector": [
          {
            "filenamePattern": "*.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "XML Viewer",
      "properties": {
        "xmlViewer.direction": {
          "type": "string",
          "enum": [
            "RIGHT",
            "DOWN"
          ],
          "default": "RIGHT",
          "description": "Default graph direction for new previews.",
          "scope": "resource"
        },
        "xmlViewer.initialDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 2,
          "description": "Initially expanded depth (document counts as level zero). Applies to new views without saved state.",
          "scope": "resource"
        },
        "xmlViewer.followSource": {
          "type": "boolean",
          "default": true,
          "description": "Select the corresponding graph node when the source cursor moves.",
          "scope": "resource"
        },
        "xmlViewer.showMetadata": {
          "type": "boolean",
          "default": false,
          "description": "Show XML comments and processing instructions by default.",
          "scope": "resource"
        },
        "xmlViewer.showWhitespace": {
          "type": "boolean",
          "default": false,
          "description": "Show whitespace and separate text nodes by default.",
          "scope": "resource"
        },
        "xmlViewer.updateDelay": {
          "type": "integer",
          "minimum": 50,
          "maximum": 3000,
          "default": 400,
          "description": "Delay in milliseconds before reparsing after an edit.",
          "scope": "resource"
        },
        "xmlViewer.maxVisibleNodes": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000,
          "default": 1000,
          "description": "Maximum drawn nodes. Smaller limits improve graph responsiveness.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:extension": "node scripts/test-extension.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --readme-path artifacts/package-readme.md",
    "vscode:prepublish": "npm run check && npm run build && npm run notices && node scripts/prepare-readme.mjs",
    "pretest": "node scripts/build.mjs",
    "notices": "node scripts/notices.mjs",
    "format": "prettier --write src tests scripts *.json *.ts .vscode",
    "benchmark:ui": "node scripts/benchmark-ui.mjs",
    "postpackage": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@rgrove/parse-xml": "^5.0.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@azure/identity": "4.13.0",
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    }
  },
  "icon": "assets/icon.png"
}
